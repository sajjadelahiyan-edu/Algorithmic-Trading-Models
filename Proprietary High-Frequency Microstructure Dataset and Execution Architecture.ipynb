import pandas as pd
import plotly.graph_objects as go
from plotly.subplots import make_subplots

df = pd.read_csv('DJIUSD_M1_202601012300_202608212059.csv', sep='\t')

# Clean up column names just in case MT5 added trailing spaces
df.columns = df.columns.str.strip()

df['Datetime'] = pd.to_datetime(df['<DATE>'] + ' ' + df['<TIME>'])
df.set_index('Datetime', inplace=True)

open_window = df.loc['2026-08-20 13:20:00':'2026-08-20 13:40:00']

fig = make_subplots(specs=[[{"secondary_y": True}]])

# Market Price (Closing price of the M1 candle)
fig.add_trace(
    go.Scatter(x=open_window.index, y=open_window['<CLOSE>'], name="Close Price", line=dict(color='#00E396', width=2)),
    secondary_y=False,
)

# The Spread Blowout (Using the native M1 <SPREAD> column)
fig.add_trace(
    go.Bar(x=open_window.index, y=open_window['<SPREAD>'], name="Spread Expansion (Points)", marker_color='rgba(255, 69, 96, 0.5)'),
    secondary_y=True,
)

# Formatting
fig.update_layout(
    title_text="US30 Market Microstructure: NY Open Spread Blowout (M1 Data)",
    xaxis_title="Time (M1)",
    template="plotly_dark",
    hovermode="x unified",
    legend=dict(orientation="h", yanchor="bottom", y=1.02, xanchor="right", x=1)
)

fig.update_yaxes(title_text="Price (USD)", secondary_y=False)
fig.update_yaxes(title_text="Spread Expansion (Points)", secondary_y=True, showgrid=False)

fig.show()
