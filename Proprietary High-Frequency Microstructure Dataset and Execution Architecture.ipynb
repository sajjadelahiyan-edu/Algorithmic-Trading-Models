# ==============================================================================
# NY Open Tick Data & Spread Analysis
# Notebook: lets completely review the trap limits in DJI
# ==============================================================================
import pandas as pd
import plotly.graph_objects as go
from plotly.subplots import make_subplots

# 1. Load the MT5 Tick Data
# Using the exact dataset provided:
df = pd.read_csv('DJIUSD_M1_202601012300_202608212059.csv', sep='\t') 

# Format DateTime (Adjust column names if your export formatting differs)
df['Datetime'] = pd.to_datetime(df['<DATE>'] + ' ' + df['<TIME>'])
df.set_index('Datetime', inplace=True)

# 2. Calculate the Live Spread
df['Spread'] = (df['<ASK>'] - df['<BID>'])

# 3. Filter for the NY Open execution window (Adjust dates to your dataset)
open_window = df.loc['2026-08-20 13:29:50':'2026-08-20 13:30:10']

# 4. Create the Interactive Plotly Chart
fig = make_subplots(specs=[[{"secondary_y": True}]])

# Bid Price (Actual Market Price)
fig.add_trace(
    go.Scatter(x=open_window.index, y=open_window['<BID>'], name="Bid Price", line=dict(color='#00E396', width=2)),
    secondary_y=False,
)

# Ask Price (What triggers Retail EAs)
fig.add_trace(
    go.Scatter(x=open_window.index, y=open_window['<ASK>'], name="Ask Price", line=dict(color='#FF4560', width=2)),
    secondary_y=False,
)

# The Spread Blowout
fig.add_trace(
    go.Bar(x=open_window.index, y=open_window['Spread'], name="Spread (Points)", marker_color='rgba(255, 255, 255, 0.2)'),
    secondary_y=True,
)

# Formatting
fig.update_layout(
    title_text="US30 Market Microstructure: NY Open Spread Blowout",
    xaxis_title="Tick Timestamp",
    template="plotly_dark",
    hovermode="x unified",
    legend=dict(orientation="h", yanchor="bottom", y=1.02, xanchor="right", x=1)
)

fig.update_yaxes(title_text="Price (USD)", secondary_y=False)
fig.update_yaxes(title_text="Spread Expansion", secondary_y=True, showgrid=False)

fig.show()
